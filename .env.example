S3_ACCESS_KEY=rustfs_local_user
S3_SECRET_KEY=rustfs_local_password

# Адрес хранилища для кода, запущенного на хосте
S3_ENDPOINT_URL=http://localhost:9000
# Адрес хранилища для контейнеров внутри docker compose
S3_INTERNAL_ENDPOINT_URL=http://rustfs:9000

S3_BUCKET=ml-product-management
S3_REGION=us-east-1

# Порты на хосте (S3 API и веб-консоль)
S3_PORT=9000
S3_CONSOLE_PORT=9001
